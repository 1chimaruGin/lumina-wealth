/* ---- explainers: small charts drawn by hand, no library ---- */
(function () {
  "use strict";
  var NS = "http://www.w3.org/2000/svg";
  var $ = function (id) { return document.getElementById(id); };
  var yen = function (n) {
    var a = Math.abs(Math.round(n));
    if (a >= 100000000) return (n < 0 ? "-" : "") + "¥" + (a / 100000000).toFixed(2) + "億";
    if (a >= 10000) return (n < 0 ? "-" : "") + "¥" + (a / 10000).toFixed(a >= 1000000 ? 0 : 1) + "万";
    return (n < 0 ? "-" : "") + "¥" + a.toLocaleString();
  };
  function el(tag, attrs) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }
  function clear(svg) { while (svg.firstChild) svg.removeChild(svg.firstChild); }

  /* One line/area chart routine for every explainer.
     series: [{points:[[x,y]...], color, label, fill}]  */
  function drawLines(svg, series, opts) {
    opts = opts || {};
    clear(svg);
    var vb = svg.viewBox.baseVal, W = vb.width, H = vb.height;
    var m = {t: 14, r: 64, b: 26, l: 8};
    var iw = W - m.l - m.r, ih = H - m.t - m.b;
    var all = series.reduce(function (a, s) { return a.concat(s.points); }, []);
    if (!all.length) return;
    var xs = all.map(function (p) { return p[0]; }), ys = all.map(function (p) { return p[1]; });
    var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs);
    var y0 = Math.min(0, Math.min.apply(null, ys)), y1 = Math.max.apply(null, ys);
    if (y1 === y0) y1 = y0 + 1;
    var X = function (v) { return m.l + (x1 === x0 ? 0 : (v - x0) / (x1 - x0)) * iw; };
    var Y = function (v) { return m.t + ih - ((v - y0) / (y1 - y0)) * ih; };

    /* recessive grid: four lines, no box */
    for (var g = 0; g <= 3; g++) {
      var gy = m.t + (ih / 3) * g;
      svg.appendChild(el("line", {x1: m.l, y1: gy, x2: m.l + iw, y2: gy,
        stroke: "var(--line)", "stroke-width": 1}));
    }
    if (y0 < 0) {
      svg.appendChild(el("line", {x1: m.l, y1: Y(0), x2: m.l + iw, y2: Y(0),
        stroke: "var(--ink-3)", "stroke-width": 1, "stroke-dasharray": "3 3"}));
    }

    series.forEach(function (s) {
      var d = s.points.map(function (p, i) { return (i ? "L" : "M") + X(p[0]).toFixed(1) + " " + Y(p[1]).toFixed(1); }).join(" ");
      if (s.fill) {
        svg.appendChild(el("path", {d: d + " L" + X(x1) + " " + Y(0) + " L" + X(x0) + " " + Y(0) + " Z",
          fill: s.color, opacity: 0.1, stroke: "none"}));
      }
      svg.appendChild(el("path", {d: d, fill: "none", stroke: s.color,
        "stroke-width": 2, "stroke-linejoin": "round", "stroke-linecap": "round"}));
      /* emphasised endpoint + direct label, so identity is never colour alone */
      var last = s.points[s.points.length - 1];
      svg.appendChild(el("circle", {cx: X(last[0]), cy: Y(last[1]), r: 4, fill: s.color,
        stroke: "var(--surface)", "stroke-width": 2}));
      var t = el("text", {x: X(last[0]) + 9, y: Y(last[1]) + 4,
        fill: "var(--ink-2)", "font-size": 11, "font-family": "var(--mono)"});
      t.textContent = s.label;
      svg.appendChild(t);
    });

    if (opts.xLabel) {
      var xt = el("text", {x: m.l, y: H - 6, fill: "var(--ink-3)", "font-size": 10.5, "font-family": "var(--mono)"});
      xt.textContent = opts.xLabel;
      svg.appendChild(xt);
    }
    if (opts.xEnd) {
      var xe = el("text", {x: m.l + iw, y: H - 6, fill: "var(--ink-3)", "font-size": 10.5,
        "font-family": "var(--mono)", "text-anchor": "end"});
      xe.textContent = opts.xEnd;
      svg.appendChild(xe);
    }
  }

  /* ---------- 1. compounding ---------- */
  function compound() {
    var amt = +$("c-amt").value, ret = +$("c-ret").value, yrs = +$("c-yrs").value;
    $("c-amt-o").textContent = yen(amt) + "/mo";
    $("c-ret-o").textContent = ret.toFixed(1) + "%";
    $("c-yrs-o").textContent = yrs + " yr";
    $("c-yrs-l").textContent = yrs;

    var r = ret / 100 / 12, bal = 0, contrib = 0, tot = [], put = [];
    for (var mth = 0; mth <= yrs * 12; mth++) {
      if (mth) { bal = bal * (1 + r) + amt; contrib += amt; }
      if (mth % 3 === 0) { tot.push([mth / 12, bal]); put.push([mth / 12, contrib]); }
    }
    $("c-total").textContent = yen(bal);
    $("c-in").textContent = yen(contrib);
    $("c-gain").textContent = yen(bal - contrib);
    drawLines($("c-svg"), [
      {points: put, color: "var(--viz-1)", label: "put in", fill: true},
      {points: tot, color: "var(--viz-2)", label: "total"}
    ], {xLabel: "year 0", xEnd: "year " + yrs});

    var share = bal > 0 ? (bal - contrib) / bal * 100 : 0;
    var half = null;
    for (var y = 1; y <= yrs; y++) {
      var b = 0, c = 0;
      for (var k = 1; k <= y * 12; k++) { b = b * (1 + r) + amt; c += amt; }
      if (b - c >= c && half === null) half = y;
    }
    $("c-note").textContent = share < 1
      ? "At this return, growth is a rounding error. The habit is what you are building, not the balance."
      : "Growth is " + share.toFixed(0) + "% of the total" +
        (half ? ", and only after year " + half + " does it exceed what you put in" : "") +
        ". The first two years look like nothing because they are nothing — that is the shape, not a failure.";
  }

  /* ---------- 2. inflation ---------- */
  function inflation() {
    var amt = +$("i-amt").value, rate = +$("i-rate").value, yrs = +$("i-yrs").value;
    $("i-amt-o").textContent = yen(amt);
    $("i-rate-o").textContent = rate.toFixed(1) + "%";
    $("i-yrs-o").textContent = yrs + " yr";

    var pts = [];
    for (var y = 0; y <= yrs; y++) pts.push([y, amt / Math.pow(1 + rate / 100, y)]);
    var end = pts[pts.length - 1][1];
    $("i-val").textContent = yen(end);
    $("i-lost").textContent = yen(amt - end) + " (" + ((1 - end / amt) * 100).toFixed(0) + "%)";
    drawLines($("i-svg"), [{points: pts, color: "var(--viz-2)", label: "real value", fill: true}],
      {xLabel: "today", xEnd: "year " + yrs});

    var halving = rate > 0 ? Math.log(2) / Math.log(1 + rate / 100) : null;
    $("i-note").textContent = rate === 0
      ? "At zero inflation nothing is lost — which has almost never been true for long."
      : "At " + rate.toFixed(1) + "%, your money halves in purchasing power every " +
        halving.toFixed(0) + " years. Nobody announces it; the number in the account never changes.";
  }

  /* ---------- 3. leverage ---------- */
  function leverage() {
    var eq = +$("l-eq").value, x = +$("l-x").value, mv = +$("l-mv").value;
    $("l-eq-o").textContent = yen(eq);
    $("l-x-o").textContent = x.toFixed(1) + "×";
    $("l-mv-o").textContent = (mv > 0 ? "+" : "") + mv + "%";

    var result = function (move) { return Math.max(0, eq * (1 + x * move / 100)); };
    var end = result(mv), pct = (end - eq) / eq * 100;
    $("l-res").textContent = yen(end);
    $("l-res-l").textContent = end === 0 ? "wiped out" : "your money afterwards";
    $("l-pct").textContent = (pct > 0 ? "+" : "") + pct.toFixed(0) + "%";
    $("l-res").className = "hero-n " + (end === 0 ? "bad" : pct > 0 ? "good" : pct < 0 ? "bad" : "");

    var pts = [];
    for (var m2 = -50; m2 <= 50; m2 += 2) pts.push([m2, result(m2)]);
    drawLines($("l-svg"), [{points: pts, color: "var(--viz-3)", label: "your money"}],
      {xLabel: "-50%", xEnd: "+50%"});

    var ruin = -100 / x;
    $("l-note").textContent = "At " + x.toFixed(1) + "× leverage a " + ruin.toFixed(0) +
      "% move against you wipes you out completely. Being right eventually does not help if you are gone before it happens.";
  }

  /* ---------- 4. cash versus profit ---------- */
  function cashflow() {
    var g = +$("k-g").value / 100, days = +$("k-d").value, marg = +$("k-m").value / 100;
    $("k-g-o").textContent = (g * 100).toFixed(0) + "%/mo";
    $("k-d-o").textContent = days + " days";
    $("k-m-o").textContent = (marg * 100).toFixed(0) + "%";

    var lag = Math.round(days / 30), sales = 1000000, prof = [], cash = [];
    var cumP = 0, cumC = 0, hist = [];
    for (var m3 = 0; m3 <= 24; m3++) {
      var s = sales * Math.pow(1 + g, m3);
      hist.push(s);
      cumP += s * marg;
      cumC -= s * (1 - marg);                       // costs paid this month
      if (m3 - lag >= 0) cumC += hist[m3 - lag];    // revenue collected, late
      prof.push([m3, cumP]);
      cash.push([m3, cumC]);
    }
    var low = Math.min.apply(null, cash.map(function (p) { return p[1]; }));
    $("k-low").textContent = yen(low);
    $("k-low").className = "hero-n " + (low < 0 ? "bad" : "good");
    $("k-prof").textContent = yen(cumP);
    $("k-cash").textContent = yen(cumC);
    drawLines($("k-svg"), [
      {points: prof, color: "var(--viz-1)", label: "profit"},
      {points: cash, color: "var(--viz-3)", label: "cash"}
    ], {xLabel: "month 0", xEnd: "month 24"});

    $("k-note").textContent = low < 0
      ? "Profitable the whole time, and still " + yen(-low) +
        " short at the worst point. That gap is what a business actually dies of."
      : "At these terms cash never goes negative. Shorten payment terms or raise margin and the hole disappears — that is the entire lever.";
  }


  /* ---------- 5. drawdown recovery ---------- */
  function drawdown() {
    var loss = +$("d-loss").value, ret = +$("d-ret").value;
    $("d-loss-o").textContent = "-" + loss + "%";
    $("d-ret-o").textContent = ret.toFixed(1) + "%";

    var floor = 1 - loss / 100;
    var need = (1 / floor - 1) * 100;
    var yrs = ret > 0 ? Math.log(1 / floor) / Math.log(1 + ret / 100) : Infinity;
    $("d-need").textContent = "+" + need.toFixed(0) + "%";
    $("d-yrs").textContent = isFinite(yrs) ? yrs.toFixed(1) : "never";
    $("d-yrs").className = "hero-n " + (yrs > 7 ? "bad" : "");

    var pts = [[0, 1], [0.35, floor]];
    var span = isFinite(yrs) ? yrs : 40;
    for (var i = 1; i <= 40; i++) {
      var y = (span * i) / 40;
      pts.push([0.35 + y, floor * Math.pow(1 + ret / 100, y)]);
    }
    drawLines($("d-svg"), [{points: pts, color: "var(--viz-2)", label: "value", fill: true}],
      {xLabel: "the fall", xEnd: isFinite(yrs) ? "+" + yrs.toFixed(1) + " years" : ""});

    $("d-note").textContent = isFinite(yrs)
      ? "A " + loss + "% fall needs +" + need.toFixed(0) + "% to undo, which at " + ret.toFixed(1) +
        "% takes " + yrs.toFixed(1) + " years of nothing happening. People do not quit at the bottom because it hurts; they quit somewhere in those " +
        yrs.toFixed(1) + " years because nothing is happening."
      : "At zero return the loss is never recovered. That is what a permanent loss of capital means.";
  }

  /* ---------- 6. time versus rate ---------- */
  function timerate() {
    var r1 = +$("t-r1").value, y1 = +$("t-y1").value, r2 = +$("t-r2").value, y2 = +$("t-y2").value;
    $("t-r1-o").textContent = r1.toFixed(1) + "%";
    $("t-y1-o").textContent = y1 + " yr";
    $("t-r2-o").textContent = r2.toFixed(1) + "%";
    $("t-y2-o").textContent = y2 + " yr";

    var M = 20000;
    function series(rate, years) {
      var r = rate / 100 / 12, bal = 0, out = [];
      for (var m = 0; m <= years * 12; m++) {
        if (m) bal = bal * (1 + r) + M;
        if (m % 3 === 0) out.push([m / 12, bal]);
      }
      return out;
    }
    var a = series(r1, y1), b = series(r2, y2);
    var va = a[a.length - 1][1], vb = b[b.length - 1][1];
    $("t-v1").textContent = yen(va);
    $("t-v2").textContent = yen(vb);
    $("t-win").textContent = yen(Math.abs(va - vb));
    $("t-win").className = "hero-n " + (va >= vb ? "good" : "bad");
    $("t-win-l").textContent = va >= vb
      ? "more, from patience alone"
      : "more, from the higher return";

    drawLines($("t-svg"), [
      {points: a, color: "var(--viz-1)", label: r1.toFixed(1) + "% · " + y1 + "y"},
      {points: b, color: "var(--viz-2)", label: r2.toFixed(1) + "% · " + y2 + "y"}
    ], {xLabel: "year 0", xEnd: "year " + Math.max(y1, y2)});

    $("t-note").textContent = va >= vb
      ? "A " + r1.toFixed(1) + "% return held for " + y1 + " years beats " + r2.toFixed(1) +
        "% held for " + y2 + ". The patient number is the ordinary one — no skill required, only the horizon."
      : "Here the higher return wins. Note what it took: " + r2.toFixed(1) +
        "% a year sustained for " + y2 + " years, which is roughly what the best investors alive manage.";
  }

  /* ---------- 7. the cost of looking ---------- */
  function checking() {
    var mu = +$("k2-r").value / 100, sd = +$("k2-v").value / 100;
    $("k2-r-o").textContent = (mu * 100).toFixed(1) + "%";
    $("k2-v-o").textContent = (sd * 100).toFixed(0) + "%";

    /* normal CDF via an erf approximation */
    function cdf(z) {
      var s = z < 0 ? -1 : 1, x = Math.abs(z) / Math.SQRT2;
      var tt = 1 / (1 + 0.3275911 * x);
      var y = 1 - (((((1.061405429 * tt - 1.453152027) * tt) + 1.421413741) * tt - 0.284496736) * tt + 0.254829592) * tt * Math.exp(-x * x);
      return 0.5 * (1 + s * y);
    }
    function pLoss(years) {
      if (years <= 0) return 0.5;
      return cdf(-(mu * years) / (sd * Math.sqrt(years)));
    }
    var horizons = [[1 / 252, "daily"], [1 / 52, "weekly"], [1 / 12, "monthly"],
                    [0.25, "quarterly"], [1, "yearly"], [5, "5 years"], [10, "10 years"]];
    $("k2-day").textContent = (pLoss(1 / 252) * 100).toFixed(0) + "%";
    $("k2-yr").textContent = (pLoss(1) * 100).toFixed(0) + "%";
    $("k2-dec").textContent = (pLoss(10) * 100).toFixed(0) + "%";

    var pts = horizons.map(function (h, i) { return [i, pLoss(h[0]) * 100]; });
    drawLines($("k2-svg"), [{points: pts, color: "var(--viz-3)", label: "chance of a loss", fill: true}],
      {xLabel: "daily", xEnd: "every 10 years"});

    $("k2-note").textContent = "Nothing about the asset changes between these numbers — only how often you look. " +
      "Check daily and you see a loss " + (pLoss(1 / 252) * 100).toFixed(0) +
      "% of the time; check once a decade and it is " + (pLoss(10) * 100).toFixed(0) +
      "%. Every look is a chance to feel you should act.";
  }

  /* ---------- 8. fee drag ---------- */
  function fees() {
    var fee = +$("f-fee").value, gross = +$("f-ret").value, yrs = +$("f-yrs").value;
    $("f-fee-o").textContent = fee.toFixed(2) + "%";
    $("f-ret-o").textContent = gross.toFixed(1) + "%";
    $("f-yrs-o").textContent = yrs + " yr";

    var M = 20000, rg = gross / 100 / 12, rn = (gross - fee) / 100 / 12;
    var bg = 0, bn = 0, g = [], n = [];
    for (var m = 0; m <= yrs * 12; m++) {
      if (m) { bg = bg * (1 + rg) + M; bn = bn * (1 + rn) + M; }
      if (m % 3 === 0) { g.push([m / 12, bg]); n.push([m / 12, bn]); }
    }
    var lost = bg - bn, pct = bg > 0 ? (lost / bg) * 100 : 0;
    $("f-lost").textContent = pct.toFixed(0) + "%";
    $("f-lost").className = "hero-n " + (pct > 20 ? "bad" : "");
    $("f-keep").textContent = yen(bn);
    $("f-take").textContent = yen(lost);
    drawLines($("f-svg"), [
      {points: n, color: "var(--viz-1)", label: "you keep"},
      {points: g, color: "var(--viz-2)", label: "no fee"}
    ], {xLabel: "year 0", xEnd: "year " + yrs});

    $("f-note").textContent = fee === 0
      ? "No fee, no drag. This is the whole argument for index funds stated as arithmetic rather than opinion."
      : fee.toFixed(2) + "% a year sounds negligible and removes " + pct.toFixed(0) +
        "% of the final balance over " + yrs + " years — " + yen(lost) +
        ". It compounds against you exactly as returns compound for you.";
  }

  var RUN = {compound: compound, inflation: inflation, leverage: leverage, cash: cashflow,
             drawdown: drawdown, timerate: timerate, checking: checking, fees: fees};

  function bind() {
    Object.keys(RUN).forEach(function (k) {
      var box = document.querySelector('[data-xp="' + k + '"]');
      if (!box) return;
      [].slice.call(box.querySelectorAll("input[type=range]")).forEach(function (inp) {
        inp.addEventListener("input", RUN[k]);
      });
      RUN[k]();
    });
  }
  /* Feature one explainer a day, chosen by the day's lesson track. The site is
     rebuilt after every brief, so this changes on its own without a scheduler. */
  function feature() {
    var data = {};
    try { data = JSON.parse(document.getElementById("lumina-data").textContent) || {}; } catch (e) {}
    var today = data.today || "";
    var track = "";
    if (data.briefs && data.briefs.length && data.briefs[0].tracks) {
      track = (data.briefs[0].tracks[0] || "");
    }
    var boxes = [].slice.call(document.querySelectorAll("[data-xp]"));
    if (!boxes.length) return;
    var matching = boxes.filter(function (b) {
      return (b.getAttribute("data-tracks") || "").split(/\s+/).indexOf(track) !== -1;
    });
    var pool = matching.length ? matching : boxes;
    /* stable for a given date: same day, same pick */
    var seed = 0;
    for (var i = 0; i < today.length; i++) seed = (seed * 31 + today.charCodeAt(i)) >>> 0;
    var chosen = pool[seed % pool.length];
    chosen.classList.add("featured");
    chosen.parentNode.insertBefore(chosen, chosen.parentNode.querySelector("[data-xp]"));
    var note = document.getElementById("xp-featured-note");
    if (note) {
      note.textContent = track
        ? "Today's pick follows the " + track + " lesson."
        : "Today's pick.";
    }
  }

  if (document.querySelector("[data-xp]")) { bind(); feature(); }
  /* redraw on theme change so marks pick up the other mode's tokens */
  var mo = new MutationObserver(function () { Object.keys(RUN).forEach(function (k) { RUN[k](); }); });
  mo.observe(document.documentElement, {attributes: true, attributeFilter: ["data-theme"]});
})();
